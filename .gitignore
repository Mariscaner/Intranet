# Dépendances installées par Composer
/vendor/
/web/core/
/web/modules/contrib/
/web/themes/contrib/
/web/profiles/contrib/
/web/libraries/
/drush/Commands/contrib/

# Fichiers générés par le scaffold Drupal
/web/*.php
/web/.htaccess
/web/robots.txt
/web/web.config
/web/sites/default/default.*
/web/sites/development.services.yml
/web/sites/example.*

# Secrets et réglages locaux : jamais dans le dépôt
/web/sites/*/settings.php
/web/sites/*/settings.local.php
/web/sites/*/services.local.yml
.env
.env.*

# Fichiers déposés et données : jamais dans le dépôt (RGPD)
/web/sites/*/files/
/private/
*.sql
*.sql.gz
*.csv
*.xlsx

# Divers
.DS_Store
.idea/
.vscode/
