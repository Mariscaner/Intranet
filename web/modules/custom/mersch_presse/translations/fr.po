# Traductions de l'interface : revue de presse (module mersch_presse).
# Traductions proposées, à relire.
msgid ""
msgstr ""
"Content-Type: text/plain; charset=UTF-8\n"
"Plural-Forms: nplurals=2; plural=(n > 1);\n"

msgid "Mersch in the press"
msgstr "Mersch dans la presse"

msgid "Press review"
msgstr "Revue de presse"

msgid "(opens in a new tab)"
msgstr "(s'ouvre dans un nouvel onglet)"

msgid "No new article."
msgstr "Aucun nouvel article."

msgid "All the press articles"
msgstr "Tous les articles de presse"

msgid "Press articles that mention the Commune of Mersch, collected every two hours. Only the title, an excerpt and the link are kept: the full article is on the media website."
msgstr "Articles de presse qui mentionnent la Commune de Mersch, collectés toutes les deux heures. Seuls le titre, un extrait et le lien sont gardés : l'article complet est sur le site du média."

msgid "Text"
msgstr "Texte"

msgid "Words in the title or excerpt…"
msgstr "Mots du titre ou de l'extrait…"

msgid "Media"
msgstr "Média"

msgid "All media"
msgstr "Tous les médias"

msgid "From"
msgstr "Du"

msgid "To"
msgstr "Au"

msgid "Include hidden articles"
msgstr "Afficher les articles masqués"

msgid "Search"
msgstr "Rechercher"

msgid "Reset"
msgstr "Réinitialiser"

msgid "Hidden"
msgstr "Masqué"

msgid "No article found."
msgstr "Aucun article trouvé."

msgid "Hide"
msgstr "Masquer"

msgid "Show again"
msgstr "Afficher de nouveau"

msgid "The article “@titre” is hidden."
msgstr "L'article « @titre » est masqué."

msgid "The article “@titre” is shown again."
msgstr "L'article « @titre » est de nouveau affiché."

msgid "News feeds"
msgstr "Flux d'actualités"

msgid "Keywords"
msgstr "Mots-clés"

msgid "Save and collect now"
msgstr "Enregistrer et collecter maintenant"

msgid "Last collection: @date. Feeds are read every two hours from 6:00 to 20:00."
msgstr "Dernière collecte : @date. Les flux sont lus toutes les deux heures de 6 h à 20 h."

msgid "No collection yet. Feeds are read every two hours from 6:00 to 20:00."
msgstr "Aucune collecte pour l'instant. Les flux sont lus toutes les deux heures de 6 h à 20 h."

msgid "One per line. An article is kept if its title or excerpt contains a word that begins with one of these keywords, regardless of case."
msgstr "Un par ligne. Un article est gardé si son titre ou son extrait contient un mot qui commence par l'un de ces mots-clés, sans tenir compte des majuscules."

msgid "Line @numero: write <code>Media | address starting with https://</code>."
msgstr "Ligne @numero : écrivez <code>Média | adresse commençant par https://</code>."

msgid "The keyword “@mot” is too short (3 characters at least)."
msgstr "Le mot-clé « @mot » est trop court (3 caractères au moins)."

msgid "Feed @nom could not be read: @message"
msgstr "Le flux @nom n'a pas pu être lu : @message"

msgid "1 new article."
msgid_plural "@count new articles."
msgstr[0] "1 nouvel article."
msgstr[1] "@count nouveaux articles."

msgid "Printed press"
msgstr "Presse écrite"

msgid "Add an article of the printed press"
msgstr "Ajouter un article de la presse écrite"

msgid "Edit"
msgstr "Modifier"

msgid "Delete"
msgstr "Supprimer"

msgid "Save"
msgstr "Enregistrer"

msgid "Add a press article"
msgstr "Ajouter un article de presse"

msgid "Edit the press article"
msgstr "Modifier l'article de presse"

msgid "Delete the press article"
msgstr "Supprimer l'article de presse"

msgid "Title"
msgstr "Titre"

msgid "For example: Luxemburger Wort, Tageblatt, Lëtzebuerger Journal."
msgstr "Par exemple : Luxemburger Wort, Tageblatt, Lëtzebuerger Journal."

msgid "Date of publication"
msgstr "Date de parution"

msgid "Excerpt"
msgstr "Extrait"

msgid "Optional, @max characters at most."
msgstr "Facultatif, @max caractères au plus."

msgid "Link"
msgstr "Lien"

msgid "Optional: address of the article if it is also online."
msgstr "Facultatif : adresse de l'article s'il est aussi en ligne."

msgid "The date cannot be in the future."
msgstr "La date ne peut pas être dans le futur."

msgid "The link must start with https://."
msgstr "Le lien doit commencer par https://."

msgid "The article “@titre” is saved."
msgstr "L'article « @titre » est enregistré."

msgid "Delete the article “@titre”?"
msgstr "Supprimer l'article « @titre » ?"

msgid "The article is deleted."
msgstr "L'article est supprimé."

msgid "Google News: sites kept"
msgstr "Google Actualités : sites gardés"

msgid "One per line, end of the site address. <code>.lu</code> keeps all Luxembourg media and leaves out foreign articles about other people called Mersch."
msgstr "Une par ligne, fin de l'adresse du site. <code>.lu</code> garde tous les médias luxembourgeois et écarte les articles étrangers sur d'autres personnes nommées Mersch."

msgid "Excluded sections"
msgstr "Rubriques exclues"

msgid "One per line. An article of a media feed whose address contains one of these parts (for example <code>/international</code>) is left out."
msgstr "Une par ligne. Un article d'un flux dont l'adresse contient l'un de ces morceaux (par exemple <code>/international</code>) est écarté."

msgid "One feed per line: <code>Media | RSS address</code>. Start a line with # to deactivate it. For a Google News search (news.google.com), only the articles of the sites below are kept, with the media given by Google."
msgstr "Un flux par ligne : <code>Média | adresse RSS</code>. Commencez une ligne par # pour la désactiver. Pour une recherche Google Actualités (news.google.com), seuls les articles des sites ci-dessous sont gardés, avec le média indiqué par Google."

msgid "For an article of the printed press that is not online. Give its title, the media, the date and, if you wish, a short excerpt and the scan or photo of the article."
msgstr "Pour un article de la presse écrite qui n'est pas en ligne. Indiquez son titre, le média, la date et, si vous le souhaitez, un court extrait et le scan ou la photo de l'article."

msgid "Scan or photo"
msgstr "Scan ou photo"

msgid "Optional: PDF, JPG or PNG, @taille at most. Only for an article about the commune; the file is deleted with the article."
msgstr "Facultatif : PDF, JPG ou PNG, @taille au plus. Uniquement pour un article sur la commune ; le fichier est supprimé avec l'article."

msgid "See the PDF"
msgstr "Voir le PDF"

msgid "See the photo"
msgstr "Voir la photo"

msgid "PDF"
msgstr "PDF"

msgid "Photo"
msgstr "Photo"
