# Traductions de l'interface de la page RH (module mersch_rh).
# LU : propositions à relire par Marc (D-005, D-022, glossaire-lu-de-fr.md).
msgid ""
msgstr ""
"Content-Type: text/plain; charset=UTF-8\n"
"Plural-Forms: nplurals=2; plural=(n != 1);\n"

msgid "New faces"
msgstr "Nouveaux visages"

msgid "At the service of the departments and the citizens"
msgstr "Au service des services communaux et des citoyens"

msgid "Thank you!"
msgstr "Merci !"

msgid "We wish you a happy retirement"
msgstr "Nous vous souhaitons une belle retraite"

msgid "Staff news"
msgstr "Nouvelles du personnel"

msgid "Organisation chart"
msgstr "Organigramme"

msgid "Updated on @date."
msgstr "Mis à jour le @date."

msgid "Open in full screen"
msgstr "Ouvrir en plein écran"

msgid "Download"
msgstr "Télécharger"

msgid "image"
msgstr "image"

msgid "Zoom with the + and − buttons of the viewer. To print, open the chart in full screen, then Ctrl+P and “Fit to page”."
msgstr "Zoomez avec les boutons + et − de la visionneuse. Pour imprimer, ouvrez l'organigramme en plein écran, puis Ctrl+P et « Ajuster à la page »."

msgid "HR has not uploaded the organisation chart yet."
msgstr "Les RH n'ont pas encore déposé l'organigramme."

msgid "Translation not available"
msgstr "Traduction non disponible"

msgid "Edit"
msgstr "Modifier"

msgid "No news at the moment."
msgstr "Aucune nouvelle pour le moment."

msgid "HR communications"
msgstr "Communications RH"

msgid "No communication at the moment."
msgstr "Aucune communication pour le moment."

msgid "Replace the organisation chart"
msgstr "Remplacer l'organigramme"

msgid "Add HR news"
msgstr "Ajouter une nouvelle RH"

msgid "Add HR communication"
msgstr "Ajouter une communication RH"

msgid "Current organisation chart"
msgstr "Organigramme actuel"

msgid "%fichier, uploaded on @date."
msgstr "%fichier, déposé le @date."

msgid "None yet."
msgstr "Aucun pour l'instant."

msgid "New organisation chart"
msgstr "Nouvel organigramme"

msgid "The PDF supplied by HR (or a PNG or JPG image), at most @taille. It replaces the current chart, which is deleted: there is no archive."
msgstr "Le PDF fourni par les RH (ou une image PNG ou JPG), @taille au maximum. Il remplace l'organigramme actuel, qui est supprimé : il n'y a pas d'archive."

msgid "Replace"
msgstr "Remplacer"

msgid "The organisation chart has been replaced."
msgstr "L'organigramme a été remplacé."

msgid "The text has @mots words; the news template recommends 80 to 150 (D-023)."
msgstr "Le texte compte @mots mots ; le gabarit des nouvelles recommande 80 à 150 mots (D-023)."

msgid "The text has @mots words; the maximum is 150 (D-023)."
msgstr "Le texte compte @mots mots ; 150 au maximum (D-023)."

msgid "A new face, a retirement or a photo requires the written consent of the person concerned (D-023)."
msgstr "Un nouveau visage, un départ à la retraite ou une photo exige l'accord écrit de la personne concernée (D-023)."

msgid "Upload the organisation chart"
msgstr "Déposer l'organigramme"

msgid "HR news"
msgstr "Nouvelle RH"

msgid "New staff, retirements and other staff news on the HR page (US-13): title, 80 to 150 words, optional photo (D-023)."
msgstr "Nouveaux agents, départs à la retraite et autres nouvelles sur la page RH : titre, 80 à 150 mots, photo facultative (D-023)."

msgid "Naming a person or showing a photo requires their written consent (D-023)."
msgstr "Nommer une personne ou montrer sa photo exige son accord écrit (D-023)."

msgid "HR communication"
msgstr "Communication RH"

msgid "Official HR notes and circulars with a PDF attachment (US-14)."
msgstr "Notes et circulaires officielles des RH, avec un PDF joint."

msgid "New face"
msgstr "Nouveau visage"

msgid "Retirement"
msgstr "Départ à la retraite"

msgid "Other news"
msgstr "Autre nouvelle"

msgid "Text"
msgstr "Texte"

msgid "Between 80 and 150 words (D-023)."
msgstr "Entre 80 et 150 mots (D-023)."

msgid "Short summary of the document."
msgstr "Court résumé du document."

msgid "Category"
msgstr "Catégorie"

msgid "New faces and retirements are grouped under their own heading on the HR page."
msgstr "Les nouveaux visages et les départs à la retraite ont chacun leur titre sur la page RH."

msgid "Department"
msgstr "Service"

msgid "For example: Service de régie / Voirie."
msgstr "Par exemple : Service de régie / Voirie."

msgid "Photo"
msgstr "Photo"

msgid "Optional. Only with the written consent of the person shown (D-023)."
msgstr "Facultative. Uniquement avec l'accord écrit de la personne photographiée (D-023)."

msgid "Written consent obtained"
msgstr "Accord écrit obtenu"

msgid "Required for a new face, a retirement or any news with a photo (D-023)."
msgstr "Obligatoire pour un nouveau visage, un départ à la retraite ou toute nouvelle avec photo (D-023)."

msgid "End of publication"
msgstr "Fin de publication"

msgid "Optional. From the day after this date, the news no longer appears on the HR page."
msgstr "Facultatif. Dès le lendemain de cette date, la nouvelle n'apparaît plus sur la page RH."

msgid "PDF document"
msgstr "Document PDF"

msgid "The note or circular, as a PDF."
msgstr "La note ou la circulaire, en PDF."

msgid "HR editor"
msgstr "Rédacteur RH"

msgid "Simple text"
msgstr "Texte simple"
