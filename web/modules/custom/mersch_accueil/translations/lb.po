msgstr "Intranet – nëmmen am Gemengennetz erreechbar"

msgid "Quick link"
msgstr "Shortcut"

msgid "Add quick link"
msgstr "Shortcut derbäisetzen"

msgid "Links to the tools shown on the home page."
msgstr "Linken op d'Tools, déi op der Startsäit ugewise ginn."

