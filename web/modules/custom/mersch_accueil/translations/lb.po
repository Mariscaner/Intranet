msgstr "Lëtzebuergesch"

msgid "German"
msgstr "Däitsch"

msgid "French"
msgstr "Franséisch"

msgid "Short text under the label. An empty language shows the Luxembourgish text."
msgstr "Kuerzen Text ënner der Bezeechnung. Eng eidel Sprooch weist de lëtzebuergeschen Text."

msgid "Full address starting with https:// or http://, for example https://helpdesk. The link opens in a new tab."
msgstr "Komplett Adress mat https:// oder http:// am Ufank, z. B. https://helpdesk. De Link geet an engem neien Tab op."

msgid "Icon"
msgstr "Ikon"

msgid "Calendar"
msgstr "Kalenner"

msgid "Document"
msgstr "Dokument"

msgid "Help"
msgstr "Hëllef"

