msgid "Home"
msgstr "Startsäit"

msgid "Human resources"
msgstr "Personalservice"

msgid "Communication"
msgstr "Kommunikatiounsservice"

msgid "IT guides"
msgstr "IT-Service"

msgid "Moien!"
msgstr "Moien!"

msgid "The intranet of the Commune of Mersch: your colleagues, your tools and news from the commune."
msgstr "Den Intranet vun der Gemeng Miersch: Är Kolleegen, Är Tools an d'Neiegkeeten aus der Gemeng."

msgid "Quick links"
msgstr "Shortcuts"

msgid "(opens in a new tab)"
msgstr "(geet an engem neien Tab op)"

msgid "Staff directory"
msgstr "Personalverzeechnes"

msgid "Search the staff directory"
msgstr "Am Personalverzeechnes sichen"

msgid "Search for a name, a department or a number…"
msgstr "Numm, Service oder Telefonsnummer sichen…"

