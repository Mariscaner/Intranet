msgid ""
msgstr ""
"Content-Type: text/plain; charset=UTF-8\n"
"Plural-Forms: nplurals=2; plural=(n != 1);\n"

msgid "Home"
msgstr "Startseite"

msgid "Human resources"
msgstr "Personalabteilung"

msgid "Communication"
msgstr "Kommunikationsabteilung"

msgid "IT guides"
msgstr "IT-Service"

msgid "Moien!"
msgstr "Guten Tag!"

msgid "The intranet of the Commune of Mersch: your colleagues, your tools and news from the commune."
msgstr "Das Intranet der Gemeinde Mersch: Ihre Kollegen, Ihre Werkzeuge und die Neuigkeiten aus der Gemeinde."

msgid "Quick links"
msgstr "Shortcuts"

msgid "(opens in a new tab)"
msgstr "(öffnet in einem neuen Tab)"

msgid "Staff directory"
msgstr "Mitarbeiterverzeichnis"

msgid "Search the staff directory"
msgstr "Im Mitarbeiterverzeichnis suchen"

msgid "Search for a name, a department or a number…"
msgstr "Name, Abteilung oder Telefonnummer suchen…"

msgid "Search"
msgstr "Suchen"

msgid "Open the full staff directory"
msgstr "Das ganze Mitarbeiterverzeichnis öffnen"

msgid "Sections"
msgstr "Rubriken"

msgid "Organisation chart, official communications and staff news."
msgstr "Organigramm, offizielle Mitteilungen und Neuigkeiten des Personals."

msgid "The Gemengebuet, the events calendar, the photo albums and internal news."
msgstr "Das Gemeindeblatt, der Veranstaltungskalender, die Fotoalben und die internen Neuigkeiten."

msgid "Solve a problem yourself, or ask IT Hëllef vu Miersch."
msgstr "Lösen Sie ein Problem selbst oder fragen Sie IT Hëllef vu Miersch."

msgid "This section is being prepared."
msgstr "Diese Rubrik wird vorbereitet."

msgid "Log in"
msgstr "Anmelden"

msgid "Log out"
msgstr "Abmelden"

msgid "Coat of arms of Mersch"
msgstr "Wappen der Gemeinde Mersch"

msgid "Intranet – only reachable on the communal network"
msgstr "Intranet – nur im Gemeindenetz erreichbar"

msgid "Quick link"
msgstr "Shortcut"

msgid "Add quick link"
msgstr "Shortcut hinzufügen"

msgid "Links to the tools shown on the home page."
msgstr "Links zu den Werkzeugen auf der Startseite."

msgid "Label (LU)"
msgstr "Bezeichnung (LU)"

msgid "Label"
msgstr "Bezeichnung"

msgid "Description"
msgstr "Beschreibung"

msgid "Status"
msgstr "Status"

msgid "Shown"
msgstr "Angezeigt"

msgid "Hidden"
msgstr "Ausgeblendet"

msgid "Luxembourgish"
msgstr "Luxemburgisch"

msgid "German"
msgstr "Deutsch"

msgid "French"
msgstr "Französisch"

msgid "Short text under the label. An empty language shows the Luxembourgish text."
msgstr "Kurzer Text unter der Bezeichnung. Bei einer leeren Sprache wird der luxemburgische Text angezeigt."

msgid "Full address starting with https:// or http://, for example https://helpdesk. The link opens in a new tab."
msgstr "Vollständige Adresse, die mit https:// oder http:// beginnt, z. B. https://helpdesk. Der Link öffnet sich in einem neuen Tab."

msgid "Icon"
msgstr "Symbol"

msgid "Calendar"
msgstr "Kalender"

msgid "Document"
msgstr "Dokument"

msgid "Help"
msgstr "Hilfe"

msgid "Website"
msgstr "Website"

msgid "Link"
msgstr "Link"

msgid "Show on the home page"
msgstr "Auf der Startseite anzeigen"

msgid "The URL %url is not valid. Enter a full address starting with https:// or http://."
msgstr "Die URL %url ist ungültig. Geben Sie eine vollständige Adresse ein, die mit https:// oder http:// beginnt."

msgid "The quick link %label has been saved."
msgstr "Der Shortcut %label wurde gespeichert."

msgid "Latest news"
msgstr "Neueste Neuigkeiten"

msgid "No news at the moment."
msgstr "Zurzeit keine Neuigkeiten."

# Boîte à idées

msgid "Ideas box"
msgstr "Ideenbox"

msgid "Idea"
msgstr "Idee"

msgid "Author"
msgstr "Verfasser"

msgid "Date"
msgstr "Datum"

msgid "Former user"
msgstr "Ehemaliger Benutzer"

msgid "Your idea to improve the intranet"
msgstr "Ihre Idee zur Verbesserung des Intranets"

msgid "Only the administrators read the ideas. Your name and the date are kept with your idea."
msgstr "Nur die Administratoren lesen die Ideen. Ihr Name und das Datum werden mit Ihrer Idee gespeichert."

msgid "Send my idea"
msgstr "Meine Idee senden"

msgid "Please write your idea."
msgstr "Bitte schreiben Sie Ihre Idee."

msgid "Your idea is too long (@max characters at most)."
msgstr "Ihre Idee ist zu lang (höchstens @max Zeichen)."

msgid "Thank you! Your idea has been sent to the administrators."
msgstr "Danke! Ihre Idee wurde an die Administratoren gesendet."

msgid "Ideas sent by staff from the home page. Delete an idea once it has been handled: only the author, the date and the text are kept. An idea is deleted automatically after 12 months."
msgstr "Ideen, die das Personal über die Startseite gesendet hat. Löschen Sie eine Idee, sobald sie bearbeitet ist: Gespeichert werden nur Verfasser, Datum und Text. Nach 12 Monaten wird eine Idee automatisch gelöscht."

msgid "No ideas yet."
msgstr "Noch keine Ideen."

msgid "Ideas sent by staff to improve the intranet."
msgstr "Ideen des Personals zur Verbesserung des Intranets."

msgid "See the idea received (1)"
msgid_plural "See the ideas received (@count)"
msgstr[0] "Die erhaltene Idee ansehen (1)"
msgstr[1] "Die erhaltenen Ideen ansehen (@count)"
