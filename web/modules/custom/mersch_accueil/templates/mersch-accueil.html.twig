{#
/**
 * @file
 * Page d'accueil : dernières nouvelles en tête, shortcuts juste en dessous
 * (US-10), puis rubriques (US-03) ; annuaire (US-06, US-07) et boîte à idées
 * dans la colonne latérale.
 *
 * Variables :
 * - liens : liste de { libelle, description, url, icone, couleur }, déjà
 *   triée ; couleur = vert, bleu, jaune, orange ou violet.
 * - annuaire : adresse de l'annuaire, ou NULL si le module est absent.
 * - rubriques : liste de { cle, titre, texte, url }.
 * - nouvelles : les dernières nouvelles des rubriques, liste de
 *   { titre, date, rubrique: { cle, titre, url }, photo } ; photo = image
 *   rendue, ou NULL (illustration de la rubrique à la place).
 * - presse : bloc « Mersch dans la presse » (module mersch_presse), ou vide.
 * - idees : boîte à idées (agents connectés) et lien vers les idées reçues
 *   (admins), vide pour un lecteur non connecté.
 */
#}
<div class="mersch-accueil">
  <h1>{{ 'Moien!'|t }}</h1>
  <p class="mersch-accueil__chapo">{{ 'The intranet of the Commune of Mersch: your colleagues, your tools and news from the commune.'|t }}</p>

  <div class="mersch-accueil__grille">
    <div class="mersch-accueil__colonne">
      <section class="mersch-bloc mersch-accueil__nouvelles" aria-labelledby="mersch-accueil-nouvelles">
        <h2 id="mersch-accueil-nouvelles">{{ 'Latest news'|t }}</h2>
        {% if nouvelles %}
          <ul class="mersch-cartes">
            {% for nouvelle in nouvelles %}
              <li class="mersch-carte" data-rubrique="{{ nouvelle.rubrique.cle }}">
                <div class="mersch-carte__image">
                  {% if nouvelle.photo %}
                    {{ nouvelle.photo }}
                  {% else %}
                    <div class="mersch-carte__defaut">
                      {% include '@mersch_accueil/mersch-rubrique-icone.html.twig' with { cle: nouvelle.rubrique.cle, classe: 'mersch-carte__picto' } only %}
                    </div>
                  {% endif %}
                </div>
                <div class="mersch-carte__corps">
                  <span class="mersch-accueil__meta">{{ nouvelle.date }}{% if nouvelle.rubrique %} · {{ nouvelle.rubrique.titre }}{% endif %}</span>
                  {% if nouvelle.rubrique %}
                    <a class="mersch-carte__titre" href="{{ nouvelle.rubrique.url }}">{{ nouvelle.titre }}</a>
                  {% else %}
                    <b class="mersch-carte__titre">{{ nouvelle.titre }}</b>
                  {% endif %}
                </div>
              </li>
            {% endfor %}
          </ul>
        {% else %}
          <p class="mersch-accueil__meta">{{ 'No news at the moment.'|t }}</p>
        {% endif %}
      </section>

      {{ presse }}

      {% if liens %}
        <section class="mersch-bloc" aria-labelledby="mersch-accueil-liens">
          <h2 id="mersch-accueil-liens">{{ 'Quick links'|t }}</h2>
          <ul class="mersch-liens">
            {% for lien in liens %}
              <li>
                <a class="mersch-liens__lien" data-couleur="{{ lien.couleur }}" href="{{ lien.url }}" target="_blank" rel="noopener noreferrer">
                  <span class="mersch-liens__pastille">
                    {% include '@mersch_accueil/mersch-lien-rapide-icone.html.twig' with { icone: lien.icone } only %}
                  </span>
                  <span class="mersch-liens__texte">
                    <b>{{ lien.libelle }} <span aria-hidden="true">↗</span></b>
                    {% if lien.description %}<span class="mersch-liens__description">{{ lien.description }}</span>{% endif %}
                    <span class="mersch-liens__adresse">{{ lien.url|replace({'https://': '', 'http://': ''}) }}</span>
                  </span>
                  <span class="visually-hidden">{{ '(opens in a new tab)'|t }}</span>
                </a>
              </li>
            {% endfor %}
          </ul>
        </section>
      {% endif %}

      <section class="mersch-bloc" aria-labelledby="mersch-accueil-rubriques">
        <h2 id="mersch-accueil-rubriques">{{ 'Sections'|t }}</h2>
        <ul class="mersch-rubriques">
          {% for rubrique in rubriques %}
            <li class="mersch-rubriques__rubrique" data-rubrique="{{ rubrique.cle }}">
              <span class="mersch-rubriques__pastille">
                {% include '@mersch_accueil/mersch-rubrique-icone.html.twig' with { cle: rubrique.cle } only %}
              </span>
              <a class="mersch-rubriques__titre" href="{{ rubrique.url }}">{{ rubrique.titre }}</a>
              <span class="mersch-rubriques__texte">{{ rubrique.texte }}</span>
            </li>
          {% endfor %}
        </ul>
      </section>
    </div>

    <aside class="mersch-accueil__cote">
      {% if annuaire %}
        <section class="mersch-bloc mersch-bloc--accueil" aria-labelledby="mersch-accueil-annuaire">
          <h2 id="mersch-accueil-annuaire">{{ 'Staff directory'|t }}</h2>
          <form class="mersch-accueil__recherche" action="{{ annuaire }}" method="get" role="search">
            <label for="mersch-accueil-recherche" class="visually-hidden">{{ 'Search the staff directory'|t }}</label>
            <input type="search" id="mersch-accueil-recherche" name="q" minlength="2"
              placeholder="{{ 'Search for a name, a department or a number…'|t }}" autocomplete="off">
            <button type="submit">{{ 'Search'|t }}</button>
          </form>
          <p><a href="{{ annuaire }}">{{ 'Open the full staff directory'|t }}</a></p>
        </section>
      {% endif %}
      {{ idees }}
    </aside>
  </div>
</div>
