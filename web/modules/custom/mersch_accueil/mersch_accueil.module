<?php

/**
 * @file
 * Page d'accueil de l'intranet : nouvelles, shortcuts, rubriques, annuaire,
 * boîte à idées.
 */

declare(strict_types=1);

/**
 * Implements hook_theme().
 */
function mersch_accueil_theme(): array {
  return [
    'mersch_accueil' => [
      'variables' => ['liens' => [], 'annuaire' => NULL, 'rubriques' => [], 'nouvelles' => [], 'presse' => NULL, 'idees' => NULL],
    ],
    'mersch_rubrique' => [
      'variables' => ['rubrique' => []],
    ],
    'mersch_lien_rapide_icone' => [
      'variables' => ['icone' => 'lien'],
    ],
    'mersch_rubrique_icone' => [
      'variables' => ['cle' => '', 'classe' => NULL],
    ],
  ];
}

/**
 * Implements hook_cron().
 *
 * Une idée est supprimée 12 mois après son envoi (D-041).
 */
function mersch_accueil_cron(): void {
  $limite = \Drupal::time()->getRequestTime() - \Drupal\mersch_accueil\Entity\Idee::CONSERVATION;
  $stockage = \Drupal::entityTypeManager()->getStorage('mersch_idee');
  $ids = $stockage->getQuery()->accessCheck(FALSE)->condition('created', $limite, '<')->range(0, 200)->execute();
  if ($ids) {
    $stockage->delete($stockage->loadMultiple($ids));
  }
}
