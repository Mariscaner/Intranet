<?php

/**
 * @file
 * Page d'accueil de l'intranet : nouvelles, shortcuts, rubriques, annuaire,
 * boîte à idées.
 */

declare(strict_types=1);

/**
 * Implements hook_theme().
 */
function mersch_accueil_theme(): array {
  return [
    'mersch_accueil' => [
      'variables' => ['liens' => [], 'annuaire' => NULL, 'rubriques' => [], 'nouvelles' => [], 'idees' => NULL],
    ],
    'mersch_rubrique' => [
      'variables' => ['rubrique' => []],
    ],
    'mersch_lien_rapide_icone' => [
      'variables' => ['icone' => 'lien'],
    ],
  ];
}
