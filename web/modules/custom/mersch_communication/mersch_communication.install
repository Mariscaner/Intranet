<?php

/**
 * @file
 * Mises à jour du module mersch_communication.
 */

declare(strict_types=1);

use Drupal\Core\Entity\Entity\EntityFormDisplay;

/**
 * Champ « Rédigé le » dans le formulaire des nouvelles, pour remonter une
 * nouvelle sur l'accueil. Drupal ne le montre qu'avec « administer nodes »
 * (admins) : les rédacteurs ne le voient pas.
 */
function mersch_communication_update_11001(): string {
  $affichage = EntityFormDisplay::load('node.comm_nouvelle.default');
  if ($affichage && !$affichage->getComponent('created')) {
    $affichage->setComponent('created', ['type' => 'datetime_timestamp', 'weight' => 20])->save();
  }
  return 'Champ « Rédigé le » affiché pour les admins.';
}
