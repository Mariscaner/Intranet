msgstr "Demander une absence dans DSKNet"

msgid "DSKNet"
msgstr "DSKNet"

msgid "DSK staff number (noPers)"
msgstr "N° DSK de l'agent (noPers)"

msgid "Leave empty: the intranet finds the staff member in DSKNet by their Windows login. Fill in only if this does not work."
msgstr "Laisser vide : l'intranet trouve l'agent dans DSKNet par son identifiant Windows. À remplir seulement si cela ne fonctionne pas."

msgid "Number of this staff member in DSKNet. Without it, the staff member does not see their DSKNet data."
msgstr "Numéro de cet agent dans DSKNet. Sans lui, l'agent ne voit pas ses données DSKNet."

msgid "Token not readable"
msgstr "Jeton illisible"

msgid "The web server cannot read the line DSKNET_TOKEN= in @fichier (docs/dsknet.md)."
msgstr "Le serveur web ne peut pas lire la ligne DSKNET_TOKEN= dans @fichier (docs/dsknet.md)."

msgid "No answer"
msgstr "Pas de réponse"

msgid "@base/test does not answer with the token. See the log: drush-intranet watchdog:show --type=mersch_dsknet"
msgstr "@base/test ne répond pas avec le jeton. Voir le journal : drush-intranet watchdog:show --type=mersch_dsknet"

msgid "Connected (@base)"
msgstr "Connecté (@base)"
