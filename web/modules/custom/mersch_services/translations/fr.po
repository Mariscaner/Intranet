msgid ""
msgstr ""
"Content-Type: text/plain; charset=UTF-8\n"
"Plural-Forms: nplurals=2; plural=(n != 1);\n"

msgid "Departments"
msgstr "Services"

msgid "Department pages"
msgstr "Pages des services"

msgid "Department page"
msgstr "Page de service"

msgid "Department editor"
msgstr "Rédacteur de service"

msgid "Add a department"
msgstr "Ajouter un service"

msgid "Pages of the departments: presentation, links, contacts and editors."
msgstr "Pages des services : présentation, liens, contacts et rédacteurs."

msgid "Each department presents its work, its tools and the colleagues to contact."
msgstr "Chaque service présente ici son travail, ses outils et les collègues à contacter."

msgid "Not published"
msgstr "Non publié"

msgid "No department page yet."
msgstr "Aucune page de service pour l'instant."

msgid "Links"
msgstr "Liens"

msgid "Contacts"
msgstr "Contacts"

msgid "Phone"
msgstr "Téléphone"

msgid "Mobile"
msgstr "GSM"

msgid "E-mail"
msgstr "E-mail"

msgid "Building"
msgstr "Bâtiment"

msgid "(opens in a new tab)"
msgstr "(s'ouvre dans un nouvel onglet)"

msgid "Edit links and contacts"
msgstr "Modifier les liens et les contacts"

msgid "Links and contacts"
msgstr "Liens et contacts"

msgid "Own page"
msgstr "Page propre"

msgid "Department"
msgstr "Service"

msgid "Page"
msgstr "Page"

msgid "Editors"
msgstr "Rédacteurs"

msgid "No department yet."
msgstr "Aucun service pour l'instant."

msgid "Each department has a page with its presentation, links and contacts. To choose the editors of a department, tick it on their account (People, Edit, “Departments edited”)."
msgstr "Chaque service a une page avec sa présentation, ses liens et ses contacts. Pour choisir les rédacteurs d'un service, cochez-le sur leur compte (Personnes, Modifier, « Services modifiés »)."

msgid "The departments you can edit: presentation, links and contacts."
msgstr "Les services que vous pouvez modifier : présentation, liens et contacts."

msgid "Section"
msgstr "Rubrique"

msgid "You can change the presentation, the links and the contacts. The name, the address and the order of the department are set by an administrator."
msgstr "Vous pouvez modifier la présentation, les liens et les contacts. Le nom, l'adresse et l'ordre du service sont fixés par un administrateur."

msgid "Contact not found in the staff directory: not shown on the page. Choose another colleague or empty the field."
msgstr "Contact introuvable dans l'annuaire : il n'est pas affiché sur la page. Choisissez un autre collègue ou videz le champ."

msgid "Colleague"
msgstr "Collègue"

msgid "Role (optional)"
msgstr "Rôle (facultatif)"

msgid "e.g. Head of department"
msgstr "ex. Chef de service"

msgid "Choose the colleague in the list that appears while you type."
msgstr "Choisissez le collègue dans la liste qui s'affiche pendant la saisie."

msgid "Presentation"
msgstr "Présentation"

msgid "What the department does and how it can help colleagues."
msgstr "Ce que fait le service et comment il peut aider les collègues."

msgid "Tools, documents and websites of the department. Drag the lines to change the order."
msgstr "Outils, documents et sites du service. Faites glisser les lignes pour changer l'ordre."

msgid "Type a name and choose the colleague in the staff directory list. The phone numbers and e-mail come from the directory."
msgstr "Tapez un nom et choisissez le collègue dans la liste de l'annuaire. Les numéros et l'e-mail viennent de l'annuaire."

msgid "Department e-mail"
msgstr "E-mail du service"

msgid "Shared mailbox of the department, shown above the contacts."
msgstr "Boîte partagée du service, affichée au-dessus des contacts."

msgid "Department phone"
msgstr "Téléphone du service"

msgid "Main number of the department, shown above the contacts."
msgstr "Numéro principal du service, affiché au-dessus des contacts."

msgid "Existing section"
msgstr "Rubrique existante"

msgid "Only for Human resources, Communication and IT guides: the links and contacts are shown at the bottom of that page."
msgstr "Seulement pour Ressources humaines, Communication et Guides informatiques : liens et contacts s'affichent en bas de cette page."

msgid "Order"
msgstr "Ordre"

msgid "Position in the list of departments: smaller numbers come first."
msgstr "Position dans la liste des services : les petits nombres d'abord."

msgid "Departments edited"
msgstr "Services modifiés"

msgid "The person can edit the presentation, links and contacts of these departments only (D-007). Set by an administrator."
msgstr "La personne ne peut modifier la présentation, les liens et les contacts que de ces services (D-007). Fixé par un administrateur."

msgid "Page of a department: presentation, links and contacts (US-22 to US-28)."
msgstr "Page d'un service : présentation, liens et contacts (US-22 à US-28)."

msgid "- All my sections -"
msgstr "- Toutes mes rubriques -"

msgid "Title contains"
msgstr "Le titre contient"

msgid "Filter"
msgstr "Filtrer"

msgid "Reset"
msgstr "Réinitialiser"

msgid "No content matches these filters."
msgstr "Aucun contenu ne correspond à ces filtres."

msgid "Unpublished"
msgstr "Non publié"

msgid "Published"
msgstr "Publié"

msgid "Published status"
msgstr "Statut"

msgid "News"
msgstr "Actualités"

msgid "No news at the moment."
msgstr "Aucune actualité pour le moment."

msgid "Add news"
msgstr "Ajouter une actualité"

msgid "Read more"
msgstr "En savoir plus"

msgid "Translation not available"
msgstr "Traduction non disponible"

msgid "Department news"
msgstr "Actualité de service"

msgid "News published by a department on its page, for example recent IT security publications (150 words at most, D-031)."
msgstr "Actualité publiée par un service sur sa page, par exemple les publications récentes sur la cybersécurité (150 mots au plus, D-031)."

msgid "The news appears on the page of this department."
msgstr "L'actualité s'affiche sur la page de ce service."

msgid "Text"
msgstr "Texte"

msgid "150 words at most (D-031)."
msgstr "150 mots au plus (D-031)."

msgid "Optional. Link to the full publication, for example a GOVCERT.LU alert or a document."
msgstr "Facultatif. Lien vers la publication complète, par exemple une alerte de GOVCERT.LU ou un document."

msgid "End of publication"
msgstr "Fin de publication"

msgid "Optional. From the day after this date, the news no longer appears on the department page."
msgstr "Facultatif. À partir du lendemain de cette date, l'actualité n'apparaît plus sur la page du service."

msgid "The text has @mots words; the maximum is 150 (D-031)."
msgstr "Le texte compte @mots mots ; le maximum est 150 (D-031)."

msgid "You can only publish news for the departments you edit."
msgstr "Vous ne pouvez publier des actualités que pour les services que vous modifiez."
